@model List<Producto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <h1 class="h3 mb-0">Productos <span class="text-muted fs-6">(@Model.Count)</span></h1>
    <a class="btn btn-naranja" asp-action="Crear">+ Nuevo producto</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-5"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Buscar por nombre, SKU o marca" /></div>
    <div class="col-md-3">
        <select name="categoriaId" asp-items="ViewBag.Categorias" class="form-select">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-md-2 d-flex align-items-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" name="stockBajo" value="true" id="stockBajo" checked="@((bool)ViewBag.StockBajo)" />
            <label class="form-check-label" for="stockBajo">Solo stock bajo</label>
        </div>
    </div>
    <div class="col-md-2"><button class="btn btn-outline-secondary w-100">Filtrar</button></div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th></th><th>SKU</th><th>Producto</th><th>Categoría</th><th class="text-end">Precio</th><th class="text-center">Stock</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr class="@(p.Activo ? "" : "text-muted")">
                        <td><img src="@(p.ImagenUrl ?? "/img/productos/sin-imagen.svg")" alt="" class="miniatura-admin" /></td>
                        <td class="small">@p.Sku</td>
                        <td>
                            <div class="fw-semibold">@p.Nombre</div>
                            <div class="small text-muted">@p.Marca @(p.Destacado ? "· ★ Destacado" : "")</div>
                        </td>
                        <td class="small">@p.Categoria?.Nombre</td>
                        <td class="text-end">
                            @if (p.EnOferta)
                            {
                                <div class="small text-muted text-decoration-line-through">@p.PrecioAnterior!.Value.Clp()</div>
                            }
                            @p.Precio.Clp()
                            @if (p.EnOferta)
                            {
                                <span class="badge bg-danger ms-1">-@p.PorcentajeDescuento%</span>
                            }
                        </td>
                        <td class="text-center">
                            <span class="badge @(p.Stock == 0 ? "bg-danger" : p.StockBajo ? "bg-warning text-dark" : "bg-light text-dark border")">@p.Stock</span>
                            <form asp-action="AjustarStock" asp-route-id="@p.Id" method="post" class="d-flex gap-1 mt-1 justify-content-center">
                                <input type="number" name="cantidad" class="form-control form-control-sm" style="width:70px" placeholder="+/-" required aria-label="Unidades a sumar o restar" />
                                <button class="btn btn-sm btn-outline-secondary" title="Sumar/restar unidades">OK</button>
                            </form>
                        </td>
                        <td>@(p.Activo ? "Visible" : "Oculto")</td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Editar" asp-route-id="@p.Id">Editar</a>
                            <form asp-action="Eliminar" asp-route-id="@p.Id" method="post" class="d-inline"
                                  data-confirmar="¿Eliminar @p.Nombre.Replace("'", "")? Si tiene ventas, solo se ocultará.">
                                <button class="btn btn-sm btn-outline-danger">Eliminar</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">No hay productos con esos filtros.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
