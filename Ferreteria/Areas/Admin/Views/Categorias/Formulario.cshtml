@model Categoria
@{
    var esNueva = Model.Id == 0;
    ViewData["Title"] = esNueva ? "Nueva categoría" : "Editar categoría";
    var iconos = new[] { "manuales", "electricas", "pinturas", "gasfiteria", "electricidad", "fijaciones", "construccion", "jardin" };
}

<a asp-action="Index" class="small">← Categorías</a>
<h1 class="h3 mt-2 mb-4">@ViewData["Title"]</h1>

<div class="card" style="max-width:640px">
    <div class="card-body">
        <form asp-action="@(esNueva ? "Crear" : "Editar")" asp-route-id="@(esNueva ? null : Model.Id)" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
            </div>
            <div class="mb-3">
                <label asp-for="Icono" class="form-label">Ícono</label>
                <select asp-for="Icono" class="form-select">
                    <option value="">(ninguno)</option>
                    @foreach (var i in iconos)
                    {
                        <option value="@i">@i</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-naranja">@(esNueva ? "Crear" : "Guardar")</button>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
