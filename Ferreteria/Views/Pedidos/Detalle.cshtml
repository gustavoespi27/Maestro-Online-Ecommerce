@model Pedido
@{
    ViewData["Title"] = $"Pedido {Model.OrdenCompra}";
}

<div class="container my-3" style="max-width:860px">
    <a asp-action="Index" class="small">← Mis pedidos</a>
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-2 mb-3 gap-2">
        <h1 class="h3 mb-0">Pedido @Model.OrdenCompra</h1>
        <partial name="_EstadoPedido" model="Model.Estado" />
    </div>

    <div class="mb-4">
        <partial name="_SeguimientoPedido" model="Model" />
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card h-100"><div class="card-body small">
                <h2 class="h6 text-uppercase fw-bold">Entrega</h2>
                <div>@Model.TipoEntrega.Nombre()</div>
                <div>@Model.NombreReceptor · @Model.Telefono</div>
                @if (Model.TipoEntrega == TipoEntrega.Despacho)
                {
                    <div>@Model.Direccion, @Model.Comuna@(Model.Region is null ? "" : ", " + Model.Region)</div>
                }
                @if (!string.IsNullOrEmpty(Model.Notas))
                {
                    <div class="text-muted mt-2">Notas: @Model.Notas</div>
                }
            </div></div>
        </div>
        <div class="col-md-6">
            <div class="card h-100"><div class="card-body small">
                <h2 class="h6 text-uppercase fw-bold">Pago</h2>
                <div>Fecha del pedido: @Model.Fecha.ToString("dd-MM-yyyy HH:mm")</div>
                @if (Model.FechaPago.HasValue)
                {
                    <div>Pagado el @Model.FechaPago.Value.ToString("dd-MM-yyyy HH:mm") con @Model.MetodoPago</div>
                    <div>Autorización: @Model.CodigoAutorizacion · Tarjeta terminada en @Model.UltimosDigitosTarjeta</div>
                }
                else if (Model.Estado == EstadoPedido.PendientePago)
                {
                    <a class="btn btn-sm btn-naranja mt-2" asp-controller="Pago" asp-action="Iniciar" asp-route-id="@Model.Id">Pagar ahora</a>
                }
            </div></div>
        </div>
    </div>

    <div class="card mt-3">
        <div class="table-responsive">
            <table class="table mb-0 align-middle">
                <thead><tr><th>Producto</th><th class="text-center">Cantidad</th><th class="text-end">Precio</th><th class="text-end">Subtotal</th></tr></thead>
                <tbody>
                    @foreach (var d in Model.Detalles)
                    {
                        <tr>
                            <td>
                                @if (d.Producto?.Activo == true)
                                {
                                    <a asp-controller="Productos" asp-action="Detalle" asp-route-id="@d.ProductoId">@d.NombreProducto</a>
                                }
                                else
                                {
                                    @d.NombreProducto
                                }
                            </td>
                            <td class="text-center">@d.Cantidad</td>
                            <td class="text-end">@d.PrecioUnitario.Clp()</td>
                            <td class="text-end">@d.Subtotal.Clp()</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr><td colspan="3" class="text-end">Subtotal</td><td class="text-end">@Model.Subtotal.Clp()</td></tr>
                    <tr><td colspan="3" class="text-end">Despacho</td><td class="text-end">@(Model.CostoDespacho == 0 ? "Gratis" : Model.CostoDespacho.Clp())</td></tr>
                    <tr class="fw-bold"><td colspan="3" class="text-end">Total</td><td class="text-end">@Model.Total.Clp()</td></tr>
                </tfoot>
            </table>
        </div>
    </div>
    <p class="small text-muted mt-3">
        ¿Problemas con tu pedido? <a asp-controller="Contacto" asp-action="Index" asp-route-asunto="Pedido" asp-route-orden="@Model.OrdenCompra">Escríbenos</a>
        · <a asp-controller="Info" asp-action="Devoluciones">Cambios y devoluciones</a>
    </p>
</div>
