@{
    ViewData["Title"] = "Error";
}
<div class="container my-5 text-center">
    <h1 class="text-danger">Ocurrió un error</h1>
    <p>No pudimos procesar tu solicitud. Intenta nuevamente en unos minutos.</p>
    @if (ViewData["RequestId"] is string id)
    {
        <p class="small text-muted">Código de referencia: <code>@id</code></p>
    }
    <a class="btn btn-naranja" asp-area="" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>
