@{
    ViewData["Title"] = "Quiénes somos";
    ViewData["Descripcion"] = "Conoce El Maestro Online: una ferretería con alma de maestro que llevó su oficio al comercio electrónico. Herramientas, materiales y asesoría experta en todo Chile.";
}

<section class="hero" style="min-height:auto">
    <div class="hero-fondo" style="background-image:url('/img/portada/hero.jpg');transform:none"></div>
    <div class="container position-relative py-5" style="z-index:2">
        <div class="py-lg-4" style="max-width:720px" data-anim="subir">
            <span class="chip-suave mb-3">🛠️ Nuestra historia</span>
            <h1 class="hero-titulo mb-3">Somos <span class="resaltado">El Maestro Online</span></h1>
            <p class="hero-texto mb-0">Una ferretería con alma de maestro que decidió llevar su oficio al comercio electrónico, para que encuentres lo que necesitas sin moverte de tu casa u obra.</p>
        </div>
    </div>
</section>

<div class="container my-5">
    <div class="row g-4 align-items-stretch">
        <div class="col-md-4" data-anim="subir">
            <div class="beneficio flex-column align-items-start h-100">
                <span class="icono">🧰</span>
                <div><strong>Todo para tu proyecto</strong><span>Herramientas manuales y eléctricas, pinturas, gasfitería, electricidad, fijaciones, construcción y jardín.</span></div>
            </div>
        </div>
        <div class="col-md-4" data-anim="subir" style="--retraso:.1s">
            <div class="beneficio flex-column align-items-start h-100">
                <span class="icono">👷</span>
                <div><strong>Asesoría de maestros</strong><span>¿No sabes qué comprar? Escríbenos por WhatsApp y te recomendamos lo justo para tu trabajo.</span></div>
            </div>
        </div>
        <div class="col-md-4" data-anim="subir" style="--retraso:.2s">
            <div class="beneficio flex-column align-items-start h-100">
                <span class="icono">🚚</span>
                <div><strong>Compra simple y segura</strong><span>Pagas con Webpay y eliges entre despacho a domicilio o retiro en tienda sin costo.</span></div>
            </div>
        </div>
    </div>

    <div class="alert alert-secondary small mt-5" data-anim="subir">
        Este sitio es un proyecto académico de INACAP. La tienda es ficticia y los pagos se hacen en el ambiente de pruebas de Transbank, sin cargos reales.
    </div>
</div>
