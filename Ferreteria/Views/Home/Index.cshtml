@model InicioVM
@{
    ViewData["Title"] = "Inicio";
    ViewData["Descripcion"] = "El Maestro Online: tu ferretería online en Chile. Hot Sale con hasta 30% de descuento en herramientas Bosch, Makita, Stanley y más. Despacho gratis sobre $50.000 y pago seguro con Webpay.";

    // El Hot Sale termina el domingo de esta semana a las 23:59
    var hoy = DateTime.Today;
    var diasHastaDomingo = ((int)DayOfWeek.Sunday - (int)hoy.DayOfWeek + 7) % 7;
    var finHotSale = hoy.AddDays(diasHastaDomingo).AddHours(23).AddMinutes(59).AddSeconds(59);
    var finIso = finHotSale.ToString("yyyy-MM-ddTHH:mm:ss");
    var slides = Model.Ofertas.Take(5).ToList();
    var maxDescuento = Model.Ofertas.Any() ? Model.Ofertas.Max(o => o.PorcentajeDescuento) : 0;
    var marcas = new[] { "BOSCH", "MAKITA", "STANLEY", "DeWALT", "TRUPER", "BAHCO", "TRICOLOR", "PHILIPS", "TRAMONTINA", "FISCHER", "MELÓN", "SIPA" };
}

@section Seo {
    <link rel="preload" as="image" href="/img/portada/hero.jpg" />
}

<!-- ===================== SLIDER HOT SALE ===================== -->
<section id="sliderHotSale" class="hero carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="6000" aria-label="Ofertas destacadas">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#sliderHotSale" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Bienvenida"></button>
        @for (var i = 0; i < slides.Count; i++)
        {
            <button type="button" data-bs-target="#sliderHotSale" data-bs-slide-to="@(i + 1)" aria-label="Oferta @(i + 1)"></button>
        }
    </div>

    <div class="carousel-inner">
        <!-- Slide de bienvenida -->
        <div class="carousel-item active">
            <div class="hero-fondo" style="background-image:url('/img/portada/hero.jpg')"></div>
            <div class="container hero-contenido">
                <div class="row align-items-center gx-0 gx-lg-5 gy-4 flex-grow-1">
                    <div class="col-lg-7">
                        <span class="chip-hot entra"><span class="punto"></span> Hot Sale · hasta @maxDescuento% OFF</span>
                        <h1 class="hero-titulo mt-3 mb-3 entra entra-2">La ferretería de los que <span class="resaltado">saben hacer las cosas</span></h1>
                        <p class="hero-texto mb-4 entra entra-3">Herramientas profesionales, materiales y asesoría de maestros. Compra online y recibe en tu casa u obra, en todo Chile.</p>
                        <div class="d-flex flex-wrap gap-2 mb-4 entra entra-4">
                            <a class="btn btn-naranja btn-lg px-4" asp-controller="Productos" asp-action="Index" asp-route-ofertas="true">🔥 Ver ofertas</a>
                            <a class="btn btn-contorno-claro btn-lg px-4" asp-controller="Productos" asp-action="Index">Explorar catálogo</a>
                        </div>
                        <div class="entra entra-5">
                            <div class="small text-white-50 mb-2 fw-semibold text-uppercase" style="letter-spacing:.1em">El Hot Sale termina en</div>
                            <div class="cuenta-regresiva" data-hasta="@finIso">
                                <div><strong data-d>00</strong><span>días</span></div>
                                <div><strong data-h>00</strong><span>horas</span></div>
                                <div><strong data-m>00</strong><span>min</span></div>
                                <div><strong data-s>00</strong><span>seg</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-5 d-none d-lg-block">
                        <div class="hero-producto entra-derecha">
                            <div class="anillo"></div>
                            <div class="marco"><img src="/img/productos/he-002.jpg" alt="Atornillador inalámbrico Makita en oferta" /></div>
                            <div class="sello-descuento"><span>HASTA</span><strong>@maxDescuento%</strong><span>DCTO</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Un slide por cada producto en oferta -->
        @foreach (var p in slides)
        {
            var fondo = p.Categoria?.Icono is string ic ? $"/img/categorias/{ic}.jpg" : "/img/portada/hero.jpg";
            <div class="carousel-item">
                <div class="hero-fondo" style="background-image:url('@fondo')"></div>
                <div class="container hero-contenido">
                    <div class="row align-items-center gx-0 gx-lg-5 gy-4 flex-grow-1">
                        <div class="col-lg-7">
                            <span class="chip-hot entra"><span class="punto"></span> Hot Sale · @p.Categoria?.Nombre</span>
                            <div class="text-uppercase fw-bold mt-3 entra entra-2" style="color:#ffb488;letter-spacing:.12em">@p.Marca</div>
                            <h2 class="hero-titulo mb-3 entra entra-2">@p.Nombre</h2>
                            <div class="hero-precios mb-2 entra entra-3">
                                <span class="ahora">@p.Precio.Clp()</span>
                                <span class="antes">@p.PrecioAnterior!.Value.Clp()</span>
                                <span class="ahorro">Ahorras @((p.PrecioAnterior.Value - p.Precio).Clp())</span>
                            </div>
                            <p class="hero-texto mb-4 entra entra-4">@p.Descripcion</p>
                            <div class="d-flex flex-wrap gap-2 entra entra-5">
                                <form asp-controller="Carrito" asp-action="Agregar" method="post">
                                    <input type="hidden" name="productoId" value="@p.Id" />
                                    <input type="hidden" name="returnUrl" value="/" />
                                    <button class="btn btn-naranja btn-lg px-4">Agregar al carrito</button>
                                </form>
                                <a class="btn btn-contorno-claro btn-lg px-4" asp-controller="Productos" asp-action="Detalle" asp-route-id="@p.Id">Ver detalle</a>
                            </div>
                        </div>
                        <div class="col-lg-5 d-none d-lg-block">
                            <div class="hero-producto entra-derecha">
                                <div class="anillo"></div>
                                <div class="marco"><img src="@p.ImagenUrl" alt="@p.Nombre en oferta" loading="lazy" /></div>
                                <div class="sello-descuento"><span>AHORRA</span><strong>@p.PorcentajeDescuento%</strong><span>DCTO</span></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#sliderHotSale" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Anterior</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#sliderHotSale" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Siguiente</span>
    </button>
    <svg class="hero-ola" viewBox="0 0 1440 50" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 50h1440V18c-160 22-360 32-720 10S160 4 0 26Z" /></svg>
</section>

<div class="container">
    <!-- ===================== BENEFICIOS ===================== -->
    <section class="beneficios-barra row g-3" aria-label="Beneficios">
        <div class="col-6 col-lg-3" data-anim="subir">
            <div class="beneficio">
                <span class="icono"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7" /><circle cx="7" cy="18" r="2" /><circle cx="17" cy="18" r="2" /></svg></span>
                <div><strong>Despacho gratis</strong><span>sobre $50.000</span></div>
            </div>
        </div>
        <div class="col-6 col-lg-3" data-anim="subir" style="--retraso:.08s">
            <div class="beneficio">
                <span class="icono"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 10 12 4l9 6v10H3z" /><path d="M9 20v-6h6v6" /></svg></span>
                <div><strong>Retiro en tienda</strong><span>sin costo adicional</span></div>
            </div>
        </div>
        <div class="col-6 col-lg-3" data-anim="subir" style="--retraso:.16s">
            <div class="beneficio">
                <span class="icono"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="13" rx="2" /><path d="M3 10h18M7 15h3" /></svg></span>
                <div><strong>Pago seguro</strong><span>Webpay Plus</span></div>
            </div>
        </div>
        <div class="col-6 col-lg-3" data-anim="subir" style="--retraso:.24s">
            <div class="beneficio">
                <span class="icono"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a8 8 0 0 1-11.8 7L4 20.5l1.5-5A8 8 0 1 1 21 12Z" /></svg></span>
                <div><strong>Asesoría experta</strong><span>maestros por WhatsApp</span></div>
            </div>
        </div>
    </section>

    <!-- ===================== CATEGORÍAS ===================== -->
    <section class="my-5 pt-3" aria-labelledby="tituloCategorias">
        <div class="cabecera-seccion" data-anim="subir">
            <div>
                <span class="antetitulo">Encuentra lo que buscas</span>
                <h2 id="tituloCategorias" class="titulo-seccion mb-0">Compra por categoría</h2>
            </div>
            <a class="enlace-flecha" asp-controller="Productos" asp-action="Index">Ver todo el catálogo <span>→</span></a>
        </div>
        <div class="row g-3">
            @{ var n = 0; }
            @foreach (var c in Model.Categorias)
            {
                var cantidad = Model.ProductosPorCategoria.GetValueOrDefault(c.Id);
                <div class="col-6 col-md-4 col-lg-3" data-anim="zoom" style="--retraso:@((n++ % 4) * 0.07)s">
                    <a class="tarjeta-categoria-foto" asp-controller="Productos" asp-action="Index" asp-route-categoriaId="@c.Id">
                        <img src="/img/categorias/@(c.Icono ?? "manuales").jpg" alt="@c.Nombre" loading="lazy" width="400" height="320" />
                        <span class="texto">
                            <strong>@c.Nombre</strong>
                            <small>@cantidad producto@(cantidad == 1 ? "" : "s") <i>→</i></small>
                        </span>
                    </a>
                </div>
            }
        </div>
    </section>

    <!-- ===================== OFERTAS RELÁMPAGO ===================== -->
    @if (Model.Ofertas.Any())
    {
        <section class="seccion-ofertas my-5" data-carril data-anim="subir" aria-labelledby="tituloOfertas">
            <div class="cabecera-seccion">
                <div>
                    <span class="antetitulo">⚡ Ofertas relámpago</span>
                    <h2 id="tituloOfertas" class="titulo-seccion mb-2">Precios de maestro, solo por esta semana</h2>
                    <div class="cuenta-regresiva" data-hasta="@finIso">
                        <div><strong data-d>00</strong><span>días</span></div>
                        <div><strong data-h>00</strong><span>horas</span></div>
                        <div><strong data-m>00</strong><span>min</span></div>
                        <div><strong data-s>00</strong><span>seg</span></div>
                    </div>
                </div>
                <div class="flechas-carril">
                    <button type="button" data-anterior aria-label="Ofertas anteriores"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m15 6-6 6 6 6" /></svg></button>
                    <button type="button" data-siguiente aria-label="Más ofertas"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m9 6 6 6-6 6" /></svg></button>
                </div>
            </div>
            <div class="carril text-body">
                @foreach (var p in Model.Ofertas)
                {
                    <partial name="_TarjetaProducto" model="p" />
                }
            </div>
        </section>
    }

    <!-- ===================== RECOMENDADO PARA TI ===================== -->
    @if (Model.Recomendados.Any())
    {
        <section class="seccion-recomendados my-5" aria-labelledby="tituloRecomendados">
            <div class="cabecera-seccion" data-anim="subir">
                <div>
                    <span class="antetitulo">✨ @(Model.HayHistorial ? "Elegido según lo que te interesa" : "Para empezar")</span>
                    <h2 id="tituloRecomendados" class="titulo-seccion mb-0">Recomendado para ti</h2>
                </div>
                <a class="enlace-flecha small" asp-controller="Info" asp-action="Privacidad" asp-fragment="recomendaciones">¿Cómo elegimos esto? <span>→</span></a>
            </div>
            <div class="row g-3">
                @{ var rIdx = 0; }
                @foreach (var r in Model.Recomendados)
                {
                    <div class="col-6 col-lg-3" data-anim="subir" style="--retraso:@((rIdx++) * 0.08)s">
                        <partial name="_TarjetaRecomendacion" model="r" />
                    </div>
                }
            </div>
        </section>
    }

    <!-- ===================== DESTACADOS ===================== -->
    @if (Model.Destacados.Any())
    {
        <section class="my-5" aria-labelledby="tituloDestacados">
            <div class="cabecera-seccion" data-anim="subir">
                <div>
                    <span class="antetitulo">Lo que más se vende</span>
                    <h2 id="tituloDestacados" class="titulo-seccion mb-0">Favoritos de los maestros</h2>
                </div>
                <a class="enlace-flecha" asp-controller="Productos" asp-action="Index">Ver todos <span>→</span></a>
            </div>
            <div class="row g-3">
                @{ var k = 0; }
                @foreach (var p in Model.Destacados)
                {
                    <div class="col-6 col-md-4 col-lg-3" data-anim="subir" style="--retraso:@((k++ % 4) * 0.08)s">
                        <partial name="_TarjetaProducto" model="p" />
                    </div>
                }
            </div>
        </section>
    }

    <!-- ===================== BANNER CON CONTADORES ===================== -->
    <section class="banner-maestro my-5 p-4 p-md-5" style="background-image:url('/img/categorias/manuales.jpg')" data-anim="zoom">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <span class="antetitulo text-white">¿Eres maestro, contratista o haces tus propios arreglos?</span>
                <h2 class="fw-bold mb-3" style="font-size:clamp(1.6rem,3vw,2.4rem)">Crea tu cuenta y compra más rápido en tu próxima obra</h2>
                <p class="mb-4" style="color:rgba(255,255,255,.88)">Guarda tus direcciones, revisa tus pedidos y entérate primero de las ofertas.</p>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn btn-blanco btn-lg px-4" asp-controller="Productos" asp-action="Index">Seguir comprando</a>
                }
                else
                {
                    <a class="btn btn-blanco btn-lg px-4" asp-controller="Cuenta" asp-action="Registro">Crear cuenta gratis</a>
                }
            </div>
            <div class="col-lg-6">
                <div class="row text-center g-3">
                    <div class="col-4 contador"><strong data-contar="@Model.TotalProductos" data-sufijo="+">@Model.TotalProductos</strong><span>productos</span></div>
                    <div class="col-4 contador"><strong data-contar="@Model.TotalCategorias">@Model.TotalCategorias</strong><span>categorías</span></div>
                    <div class="col-4 contador"><strong data-contar="@Model.TotalMarcas">@Model.TotalMarcas</strong><span>marcas reconocidas</span></div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===================== NOVEDADES ===================== -->
    @if (Model.Nuevos.Any())
    {
        <section class="my-5" aria-labelledby="tituloNuevos">
            <div class="cabecera-seccion" data-anim="subir">
                <div>
                    <span class="antetitulo">Recién llegados</span>
                    <h2 id="tituloNuevos" class="titulo-seccion mb-0">Novedades en la tienda</h2>
                </div>
            </div>
            <div class="row g-3">
                @{ var j = 0; }
                @foreach (var p in Model.Nuevos)
                {
                    <div class="col-6 col-lg-3" data-anim="subir" style="--retraso:@((j++) * 0.08)s">
                        <partial name="_TarjetaProducto" model="p" />
                    </div>
                }
            </div>
        </section>
    }

    <!-- ===================== MARCAS ===================== -->
    <section class="my-5" aria-label="Marcas que vendemos">
        <p class="text-center antetitulo d-block mb-0" data-anim="subir">Trabajamos con las mejores marcas</p>
        <div class="marcas">
            <div class="marcas-pista">
                @foreach (var m in marcas.Concat(marcas))
                {
                    <span>@m</span>
                }
            </div>
        </div>
    </section>

    <!-- ===================== BOLETÍN ===================== -->
    <section class="boletin p-4 p-md-5 my-5" data-anim="subir" aria-labelledby="tituloBoletin">
        <div class="row align-items-center g-4 position-relative" style="z-index:1">
            <div class="col-lg-6">
                <span class="antetitulo">Club El Maestro</span>
                <h2 id="tituloBoletin" class="titulo-seccion mb-2">Recibe las ofertas antes que nadie</h2>
                <p class="text-muted mb-0">Un correo a la semana con los descuentos del Hot Sale y consejos de maestro. Sin spam.</p>
            </div>
            <div class="col-lg-6">
                <form class="d-flex flex-column flex-sm-row gap-2" data-boletin>
                    <label for="correoBoletin" class="visually-hidden">Tu correo</label>
                    <input id="correoBoletin" type="email" class="form-control form-control-lg" placeholder="tucorreo@ejemplo.cl" required />
                    <button class="btn btn-naranja btn-lg px-4 text-nowrap" type="submit">Quiero ofertas</button>
                </form>
            </div>
        </div>
    </section>
</div>
