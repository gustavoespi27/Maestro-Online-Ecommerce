@model LoginVM
@{
    ViewData["Title"] = "Ingresar";
}

<div class="container my-4" style="max-width:440px">
    <div class="card tarjeta-formulario">
        <div class="cabecera">
            <img src="~/img/logo.svg" alt="" width="56" height="56" class="mb-2" />
            <h1 class="h4 fw-bold mb-1">Ingresar</h1>
            <p class="small mb-0" style="color:rgba(255,255,255,.7)">¡Qué bueno verte de nuevo, maestro!</p>
        </div>
        <div class="card-body p-4">
            <form asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" autocomplete="username" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Recordarme" class="form-check-input" />
                    <label asp-for="Recordarme" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-naranja btn-lg w-100">Ingresar</button>
            </form>
            <hr />
            <p class="small mb-0 text-center">
                ¿No tienes cuenta? <a asp-action="Registro" asp-route-returnUrl="@Model.ReturnUrl">Regístrate aquí</a>
            </p>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
