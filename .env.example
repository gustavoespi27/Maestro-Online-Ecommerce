# Copia este archivo como ".env" y cambia los valores. El archivo .env NO se sube a GitHub.

# Contraseña del usuario "sa" de SQL Server (mínimo 8 caracteres, con mayúscula, minúscula, número y símbolo)
SQL_PASSWORD=CambiaEsta.Clave123

# Cuenta de administrador de la tienda (mínimo 8 caracteres, con mayúscula, minúscula y número)
ADMIN_EMAIL=admin@ferreteria.cl
ADMIN_PASSWORD=CambiaEsta123

# Pagos: "Simulado" (demo, no requiere llaves) o "Webpay" (Transbank)
PAGOS_MODO=Simulado
# Solo si PAGOS_MODO=Webpay. Las llaves del ambiente de integración están en la documentación de Transbank:
# https://www.transbankdevelopers.cl/documentacion/como_empezar#ambientes
WEBPAY_CODIGO_COMERCIO=
WEBPAY_API_KEY_SECRET=
